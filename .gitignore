# ==========================================
# Vision.IO Project - Git Ignore Patterns
# ==========================================

# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# --- Virtual Environments ---
venv/
.venv/
env/
.env/
ENV/
env.bak/
venv.bak/

# --- IDEs / Editors ---
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.swp
.project
.pydevproject
.settings/

# --- Operating System ---
.DS_Store
Thumbs.db
Desktop.ini

# --- Large Model Files (YOLO / PyTorch / ONNX) ---
*.pt
*.pth
*.onnx
*.engine
*.weights

# --- Database & Storage ---
*.db
*.sqlite
*.sqlite3
chroma_db/

# --- Application Runtime / Generated Assets ---
mock_snapshot.jpg
screen.png
incidents/*
!incidents/.gitkeep
